{
  "name": "PS5 Hub",
  "description": "Extensible PlayStation 5 plugin dashboard",
  "version": "9689d85",
  "slug": "ps5-hub",
  "maintainer": "sanchitd5 <sanchitd4@gmail.com>",
  "url": "https://github.com/sanchitd5/ps5-hub",
  "documentation": "https://github.com/sanchitd5/ps5-hub",
  "ports": {
    "443/tcp": 443,
    "80/tcp": 80
  },
  "ports_description": {
    "443/tcp": "HTTPS: manuals.playstation.net DNS-rewrite target + hub dashboard",
    "80/tcp": "HTTP: redirects to HTTPS"
  },
  "arch": [
    "armhf",
    "armv7",
    "aarch64"
  ],
  "startup": "application",
  "boot": "auto",
  "network": true,
  "init": false,
  "options": {
    "payload_manager_url": "http://192.168.1.4:8000",
    "webkit_autoloader_url": "http://192.168.1.3:8082/app/v0/"
  },
  "schema": {
    "payload_manager_url": "url",
    "webkit_autoloader_url": "url"
  }
}
